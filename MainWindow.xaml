<Window x:Class="WPF_Napló.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Napló"
        mc:Ignorable="d"
        Title="MainWindow" Height="700" Width="500">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="5*"/>
        </Grid.RowDefinitions>
        <Label Content="Neve:" VerticalAlignment="Center" Margin="5"/>
        <TextBox Background="LightYellow" Grid.Column="1" Height="20" Margin="10" x:Name="txtNeve"/>
        <Label Grid.Row="1" Content="Dátum:" VerticalAlignment="Center" Margin="5"/>
        <DatePicker Grid.Column="1" Grid.Row="1" BorderThickness="1" VerticalAlignment="Center" Margin="10" x:Name="datDatum"   />
        <Label Grid.Row="2" Content="Tantárgy:" VerticalAlignment="Center" Margin="5"/>
        <ComboBox Grid.Column="1" Grid.Row="2" Margin="10" Height="20" x:Name="cbTantargyak">
            <ComboBoxItem Content="Matematika" IsSelected="True"/>
            <ComboBoxItem Content="Angol nyelv"/>
            <ComboBoxItem Content="Fizika"/>
            <ComboBoxItem Content="Történelem"/>
            <ComboBoxItem Content="Magyar irodalom"/>
        </ComboBox>
        <WrapPanel Grid.Row="3" VerticalAlignment="Center" Margin="5">
            <Label Content="Jegy:" />
            <Label Content="5" Foreground="Red" FontWeight="Bold" x:Name="lbJegyValtozas" />
        </WrapPanel>
        <Slider x:Name="sliJegyek" Grid.Column="1" Grid.Row="3" VerticalAlignment="Center" Margin="10" 
                TickFrequency="1" IsSnapToTickEnabled="True" Minimum="1" Maximum="5" ValueChanged="sliJegyek_ValueChanged"
                Value="5"/>
        <Button Grid.Row="4" Margin="20 15" Content="Napló betöltése"/>
        <Button Grid.Row="4" Grid.Column="1" Margin="20 15" Content="Rögzít naplóba" x:Name="btnRogzit" Click="btnRogzit_Click"/>
        <ListBox Grid.Row="5" Grid.ColumnSpan="2" Background="DarkSeaGreen" Margin="10" x:Name="lsbJegyek"/>
    </Grid>
</Window>
